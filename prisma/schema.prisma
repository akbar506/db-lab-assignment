generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model User {
  id          String    @id @default(uuid()) @db.Char(36)
  username    String    @db.VarChar(50)
  email       String    @unique @db.VarChar(255)
  password    String    @db.VarChar(255)
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  updated_at  DateTime? @updatedAt

  surveys     Survey[]
  sessions    Session[]
  accounts    Account[]
}

model Survey {
  id                             String         @id @default(uuid()) @db.Char(36)
  user_id                        String         @db.Char(36)
  full_name                      String         @db.VarChar(150)
  age                            Int
  gender                         surveys_gender
  email                          String         @db.VarChar(255)
  preferred_programming_language String?        @db.VarChar(100)
  programming_languages_known    String?        @db.Text
  favorite_ide                   String?        @db.VarChar(100)
  preferred_lab_time             String?        @db.VarChar(100)
  lab_infrastructure_rating      Int?
  satisfaction_level             Int?
  suggestions                    String?        @db.Text
  additional_feedback            String?        @db.Text
  submission_date                DateTime?      @default(now()) @db.Timestamp(0)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model Session {
  id         String   @id @default(uuid()) @db.Char(36)
  token      String   @unique
  user_id    String   @db.Char(36)
  expiresAt  DateTime
  ipAddress String?
  userAgent String?
  createdAt  DateTime @default(now())
  updatedAt DateTime? @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Account {
  id                    String  @id @default(uuid())

  user_id                String  @db.Char(36)

  accountId             String

  providerId            String

  access_token           String? @db.Text

  refresh_token          String? @db.Text

  accessTokenExpiresAt  DateTime?

  refreshTokenExpiresAt DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

enum surveys_gender {
  Male
  Female
}
